#!/usr/bin/env ruby

require 'bitflyer/cli'

begin
  Bitflyer::Cli::Runner.start
rescue CancelAllCommand::Rejected, CancelOrderCommand::Failed, OpenOrdersCommand::LookupFailed,
       ExecutionsCommand::LookupFailed, StopByRangeCommand::LookupFailed,
       Bitflyer::Cli::OrderRejected, HasHTTPClient::TickerError => e
  abort e.message
end
